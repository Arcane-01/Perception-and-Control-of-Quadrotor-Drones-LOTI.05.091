<?xml version="1.0" ?>
<robot name="unit_cylinder">

  <!-- Base link -->
  <link name="cylinder_link">
    <!-- Visual representation -->
    <visual>
      <geometry>
        <cylinder radius=".5" length="1.0"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <!-- Collision shape -->
    <collision>
      <geometry>
        <cylinder radius=".5" length="1.0"/>
      </geometry>
    </collision>

    <!-- Inertial properties -->
    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.0833"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0833"
        iyz="0.0"
        izz="0.0833"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

</robot>
