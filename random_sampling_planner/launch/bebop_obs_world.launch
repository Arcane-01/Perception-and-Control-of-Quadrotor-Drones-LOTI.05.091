<?xml version="1.0"?>

<launch>
  <arg name="world_name" default="env4"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find random_sampling_planner)/worlds/$(arg world_name).world"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="debug" value="$(arg debug)"/>
  </include>

  <include file="$(find bebop_gazebo)/launch/spawn_bebop.launch" />

  <!-- Node for pcd transform -->
  <node pkg="random_sampling_planner" type="pcd_transform.py" name="pcd_tf_py" required="true"/> 
  
  <node type="rviz" name="rviz" pkg="rviz" args="-d $(find random_sampling_planner)/rviz/planner.rviz" />

</launch>